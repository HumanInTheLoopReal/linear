{
  "name": "linear",
  "description": "AI-supervised CLI for Linear.app. Manage issues, discover work, recover context after compaction.",
  "version": "2026.8.1",
  "author": {
    "name": "Linear CLI maintainers",
    "url": "https://github.com/HumanInTheLoopReal/linear"
  },
  "repository": "https://github.com/HumanInTheLoopReal/linear",
  "license": "MIT",
  "homepage": "https://github.com/HumanInTheLoopReal/linear#readme",
  "keywords": [
    "linear",
    "issue-tracker",
    "task-management",
    "ai-workflow",
    "agent-memory"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "linear prime"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "linear prime --memories-only"
          }
        ]
      }
    ]
  }
}
