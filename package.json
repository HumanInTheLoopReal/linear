{
  "name": "@humanintheloop/linear",
  "version": "2026.9.0",
  "description": "AI-first JSON CLI for Linear.app",
  "main": "dist/main.js",
  "type": "module",
  "bin": {
    "linear": "dist/main.js"
  },
  "files": [
    "dist/",
    "plugins/linear/skills/linear/",
    "README.md",
    "LICENSE.md",
    "USAGE.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc && npm run copy-assets",
    "copy-assets": "mkdir -p dist/molecules/builtin && cp src/molecules/builtin/*.toml dist/molecules/builtin/ && chmod +x dist/main.js",
    "clean": "rm -rf dist/",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:smoke": "node scripts/run-tokenless-integration.mjs",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:commands": "node scripts/run-command-coverage.mjs",
    "generate": "graphql-codegen --config codegen.config.ts",
    "generate:usage": "tsx src/main.ts usage --all > USAGE.md",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "verify:packed-binaries": "node scripts/verify-packed-binaries.mjs",
    "verify:plugin-versions": "node scripts/release/plugin-versions.mjs --check",
    "release": "npm run verify:plugin-versions && npm run check:ci && npx tsc --noEmit && npm test && npm run build && npm run test:integration:smoke && npm run test:commands && npm run verify:packed-binaries && npx clean-publish --without-publish --temp-dir release-package && npm publish ./release-package --access public",
    "prestart": "npm run generate",
    "predev": "npm run generate",
    "prebuild": "npm run generate && npm run generate:usage",
    "prepare": "npm run generate && lefthook install",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "release:explain": "node scripts/release/explain.mjs",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "release:run": "semantic-release"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "linear",
    "agents",
    "llm",
    "ticketing",
    "cli"
  ],
  "author": "Human in the Loop",
  "contributors": [],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HumanInTheLoopReal/linear.git"
  },
  "bugs": {
    "url": "https://github.com/HumanInTheLoopReal/linear/issues"
  },
  "homepage": "https://github.com/HumanInTheLoopReal/linear#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "0.95.2",
    "@linear/sdk": "82.1.0",
    "commander": "14.0.3",
    "node-emoji": "2.2.0",
    "smol-toml": "1.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/client-preset": "^5.2.2",
    "@graphql-codegen/introspection": "5.0.2",
    "@graphql-codegen/schema-ast": "^5.0.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.0.0",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.0.0",
    "@vitest/ui": "^4.0.0",
    "clean-publish": "^6.0.5",
    "lefthook": "^2.1.0",
    "semantic-release": "^25.0.1",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0",
    "vitest": "^4.0.0"
  },
  "graphql": {
    "schema": "https://api.linear.app/graphql",
    "documents": "**/*.graphql"
  },
  "clean-publish": {
    "fields": [
      "scripts",
      "graphql"
    ]
  }
}
